# Convex — filled by `npx convex dev` locally; override for Vercel Production
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://artful-monitor-177.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://artful-monitor-177.convex.site
# Alias required by @convex-dev/better-auth (same value as NEXT_PUBLIC_CONVEX_SITE_URL)
CONVEX_SITE_URL=https://artful-monitor-177.convex.site

# Public site origin (customer app) — must match live domain in prod
NEXT_PUBLIC_SITE_URL=https://www.boltenergy.me

# Backoffice origin — live Vercel host (no custom domain)
NEXT_PUBLIC_BACKOFFICE_URL=https://solar-backoffice-amrayman100s-projects.vercel.app

# Google Analytics 4 (customer site — public measurement ID)
NEXT_PUBLIC_GA_ID=G-SDXGEP99RN

